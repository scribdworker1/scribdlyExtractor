# ── Environment ────────────────────────────────────────
PORT=3000
NODE_ENV=production

# Secret shared with your base VPS — only requests with this key are accepted
WORKER_SECRET=change-me-to-a-long-random-secret

# Optional: override Chrome binary path (auto-detected on Railway/Koyeb via Dockerfile)
# CHROME_PATH=/usr/bin/chromium

